{
  "name": "hipaypayments/prestashop",
  "version": "5.0.1",
  "description": "HiPay module for PrestaShop",
  "license": "proprietary",
  "authors": [
    {
      "name": "PrestaShop & HiPay partner",
      "homepage": "https://www.prestashop.com"
    }
  ],
  "config": {
    "prepend-autoloader": false,
    "platform": {
      "php": "8.1"
    },
    "audit": {
      "block-insecure": false
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "autoload": {
    "psr-4": {
      "HiPay\\PrestaShop\\": "src/"
    },
    "classmap": [
      "hipaypayments.php",
      "controllers",
      "classes"
    ]
  },
  "require": {
    "php": ">=8.1",
    "anthogirard/ps-module-utils": "~3.0.1",
    "koriym/http-constants": "^1.2",
    "ramsey/uuid": "^4.9",
    "hipay/hipay-fullservice-sdk-php": "^2.24",
    "giggsey/libphonenumber-for-php": "^9.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "prestashop/php-dev-tools": "^5.0",
    "phpstan/phpstan": "^2.1"
  }
}
